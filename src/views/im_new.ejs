<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>New IM Experiment</title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script defer src="/public/im.js"></script>
  </head>
  <body>
    <header>
      <h1>New IM Experiment</h1>
      <%- include('partials/nav', { active: 'im' }) %>
    </header>
    <main>
      <div class="card">
        <form method="POST" action="/im">
          <div class="inline-grid">
            <div>
              <label>Experiment name</label>
              <input name="name" required />
            </div>
            <div>
              <label>Machine profile</label>
              <select name="machine_profile_id">
                <% profiles.forEach((p) => { %>
                  <option value="<%= p.id %>"><%= p.name %> (zones: <%= p.barrel_zones_count %>)</option>
                <% }) %>
              </select>
            </div>
            <div>
              <label>Seed (optional)</label>
              <input name="seed" type="number" inputmode="numeric" />
            </div>
            <div>
              <label>Default material moisture (%)</label>
              <input name="default_material_moisture_pct" type="number" step="0.01" inputmode="decimal" />
            </div>
            <div>
              <label>Default material density (g/cm3)</label>
              <input name="default_material_density_g_cm3" type="number" step="0.001" inputmode="decimal" />
            </div>
          </div>

          <div class="card" style="margin-top:16px;">
            <h3>Recipes for this experiment</h3>
            <% if (recipes.length === 0) { %>
              <div class="note">No recipes yet. Create recipes first.</div>
            <% } %>
            <div class="recipe-select-list" data-recipe-list>
              <% recipes.forEach((r) => { %>
                <button type="button" class="recipe-pill" data-recipe-pill>
                  <input type="checkbox" name="recipe_ids" value="<%= r.id %>" />
                  <span><%= r.name %></span>
                  <% if (r.has_range) { %>
                    <span class="badge">min-max</span>
                  <% } %>
                </button>
              <% }) %>
            </div>
          </div>

          <div style="margin-top:12px;">
            <button type="submit">Create IM Experiment</button>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
