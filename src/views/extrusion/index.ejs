<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Extrusion Flow Experiments</title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script defer src="/public/app.js"></script>
  </head>
  <body>
    <header>
      <div class="header-line">
        <a class="back-link" href="#" data-back-link>←</a>
        <h1>Extrusion Flow Experiments</h1>
      </div>
      <%- include('../shared/partials/nav', { active: 'extrusion' }) %>
    </header>
    <main>
      <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h2>Extrusion Flow Experiments</h2>
          <a class="btn" href="/extrusion/new">New Extrusion Experiment</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Runs</th>
                <th>Notes</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (experiments.length === 0) { %>
                <tr><td colspan="6">No extrusion experiments yet.</td></tr>
              <% } %>
              <% experiments.forEach((e) => { %>
                <tr>
                  <td><%= e.id %></td>
                  <td><a href="/extrusion/<%= e.id %>"><%= e.name %></a></td>
                  <td><%= e.run_count %></td>
                  <td><%= e.notes || '' %></td>
                  <td><%= e.created_at %></td>
                  <td>
                    <form method="POST" action="/extrusion/<%= e.id %>/delete" onsubmit="return confirm('Delete this extrusion experiment? This cannot be undone.');">
                      <button class="link danger" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>

