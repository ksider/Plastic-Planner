<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= experiment.name %></title>
    <link rel="stylesheet" href="/public/styles.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <script defer src="/public/app.js"></script>
    <script defer src="/public/analysis.js"></script>
  </head>
  <body>
    <header>
      <div class="header-line">
        <a class="back-link" href="#" data-back-link>←</a>
        <h1><%= experiment.name %></h1>
        <button type="button" class="icon-btn" data-open-modal="experiment-details-modal" title="Edit experiment" aria-label="Edit experiment">
          <span class="material-symbols-outlined">edit</span>
        </button>
      </div>
      <%- include('../shared/partials/nav', { active: 'compounding' }) %>
      <div class="small">Seed: <%= experiment.seed %> · Final mass: <%= experiment.final_mass_g %> g</div>
      <form method="POST" action="/experiments/<%= experiment.id %>/delete" onsubmit="return confirm('Delete experiment and all data?')" style="margin-top:8px;">
        <button class="btn secondary" type="submit">Delete Experiment</button>
      </form>
    </header>
    <main>
      <div class="modal" data-modal="experiment-details-modal">
        <div class="modal-backdrop" data-close-modal="experiment-details-modal"></div>
        <div class="modal-card">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <h3 style="margin:0;">Edit experiment</h3>
            <button type="button" class="icon-btn" data-close-modal="experiment-details-modal" aria-label="Close">✕</button>
          </div>
          <form method="POST" action="/experiments/<%= experiment.id %>/update" class="inline-grid" style="margin-top:12px;">
            <div>
              <label>Name</label>
              <input name="name" value="<%= experiment.name %>" required />
            </div>
            <div>
              <label>Seed</label>
              <input name="seed" type="number" inputmode="numeric" value="<%= experiment.seed %>" required />
            </div>
            <div style="grid-column:1/-1;">
              <label>Notes</label>
              <textarea name="notes" rows="2"><%= experiment.notes || '' %></textarea>
            </div>
            <div style="align-self:end; display:flex; gap:8px;">
              <button type="button" class="secondary" data-close-modal="experiment-details-modal">Cancel</button>
              <button type="submit">Save</button>
            </div>
          </form>
        </div>
      </div>
      <div class="tab-buttons">
        <button class="active" data-tab-target="tab-design">Design / Inputs</button>
        <button data-tab-target="tab-data">Data Entry</button>
        <button data-tab-target="tab-analysis">Analysis</button>
      </div>

      <section id="tab-design" class="tab-panel active">
        <div class="card">
          <h2>Experiment Inputs</h2>
          <div class="inline-grid">
            <div>
              <label>Final mass (g)</label>
              <div><%= experiment.final_mass_g %></div>
            </div>
            <div>
              <label>Seed</label>
              <div><%= experiment.seed %></div>
            </div>
            <div>
              <label>Mold temps</label>
              <div><%= JSON.parse(experiment.mold_temps_json).join(', ') %></div>
            </div>
            <div>
              <label>Head temps</label>
              <div><%= JSON.parse(experiment.head_temps_json || '[]').join(', ') %></div>
            </div>
            <div>
              <label>Replicates per temp</label>
              <div><%= experiment.replicates_per_temp %></div>
            </div>
          </div>
          <div style="display:flex; gap:12px; align-items:center; margin-top:12px;">
            <form method="POST" action="/experiments/<%= experiment.id %>/generate-molding" data-confirm-reset="<%= samplesCount > 0 ? '1' : '0' %>">
              <button type="submit">Generate / Regenerate Table B (Molding Plan)</button>
            </form>
            <% if (samplesCount > 0) { %>
              <div class="small">Table B already exists. Go to Data Entry.</div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h2>Table A: Compounding Plan</h2>
          <div style="display:flex; gap:8px; margin-bottom:8px;">
            <button class="secondary" data-copy-table="table-a">Copy as TSV</button>
            <a class="btn" href="/experiments/<%= experiment.id %>/export/tableA.csv">Download CSV</a>
          </div>
          <div class="table-wrap">
            <table id="table-a">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>BatchCode</th>
                  <th>Recipe</th>
                  <% componentOrder.forEach((name) => { %>
                    <th><%= name %> g</th>
                  <% }) %>
                  <th>Total g</th>
                  <th>Head set</th>
                  <th>Head actual</th>
                  <th>Moist after dry</th>
                  <th>Moist before mold</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% batches.forEach((b) => { %>
                  <tr class="<%= b.done ? 'row-done' : '' %>">
                    <td><%= b.compound_order %></td>
                    <td>
                      <a href="/experiments/<%= experiment.id %>/batches/<%= b.id %>"><%= b.batch_code %></a>
                      <% if (b.done) { %>
                        <span class="badge ok">DONE</span>
                      <% } %>
                    </td>
                    <td><%= b.recipe_name %></td>
                    <% componentOrder.forEach((name) => { %>
                      <td><%= formatNumber(b.weights && b.weights[name] !== undefined ? b.weights[name] : '') %></td>
                    <% }) %>
                    <td><%= formatNumber(b.total_g) %></td>
                    <td><input data-inline-save data-url="/experiments/<%= experiment.id %>/batches/<%= b.id %>" name="head_set" value="<%= b.head_set ?? '' %>" /></td>
                    <td><input data-inline-save data-url="/experiments/<%= experiment.id %>/batches/<%= b.id %>" name="head_actual" value="<%= b.head_actual ?? '' %>" /></td>
                    <td><input data-inline-save data-url="/experiments/<%= experiment.id %>/batches/<%= b.id %>" name="moist_after_dry" value="<%= b.moist_after_dry ?? '' %>" /></td>
                    <td><input data-inline-save data-url="/experiments/<%= experiment.id %>/batches/<%= b.id %>" name="moist_before_mold" value="<%= b.moist_before_mold ?? '' %>" /></td>
                    <td><textarea data-inline-save data-url="/experiments/<%= experiment.id %>/batches/<%= b.id %>" name="notes_compound"><%= b.notes_compound ?? '' %></textarea></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="tab-data" class="tab-panel">
        <div class="card">
          <h2>Table B: Molding Samples</h2>
          <% if (samples.length === 0) { %>
            <div class="note">No molding samples yet. Go to Design/Inputs and click Generate.</div>
          <% } %>
          <div style="display:flex; justify-content:space-between; align-items:center; margin:12px 0;">
            <div class="small">Custom fields appear as new columns in Table B.</div>
            <button type="button" class="secondary" data-open-field-modal>Add Field</button>
          </div>
          <div class="modal" id="field-modal" aria-hidden="true">
            <div class="modal-backdrop" data-close-field-modal></div>
            <div class="modal-card">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="margin:0;" data-field-modal-title>Add Table B Field</h3>
                <button type="button" class="icon-btn" data-close-field-modal aria-label="Close">
                  <span class="material-symbols-outlined">close</span>
                </button>
              </div>
              <form method="POST" action="/experiments/<%= experiment.id %>/fields" data-add-action="/experiments/<%= experiment.id %>/fields" class="inline-grid" style="margin-top:12px;" data-field-form>
                <input type="hidden" name="key" value="" data-field-key-input />
                <div>
                  <label>Field name</label>
                  <input name="label" placeholder="e.g. Flexural MPa" required data-field-label-input />
                </div>
                <div>
                  <label>Type</label>
                  <select name="type" data-field-type-input>
                    <option value="number">Number</option>
                    <option value="text">Text</option>
                    <option value="tags">Tags</option>
                  </select>
                </div>
                <div>
                  <label>Tag options (comma-separated)</label>
                  <input name="options" placeholder="foaming, warpage, bubbles" data-field-options-input />
                </div>
                <div style="align-self:end; display:flex; gap:8px;">
                  <button type="button" class="secondary" data-close-field-modal>Cancel</button>
                  <button type="submit">Add Field</button>
                </div>
              </form>
            </div>
          </div>
          <div style="display:flex; gap:8px; margin-bottom:8px;">
            <button class="secondary" data-copy-table="table-b">Copy as TSV</button>
            <a class="btn" href="/experiments/<%= experiment.id %>/export/tableB.csv">Download CSV</a>
            <a class="btn secondary" href="/experiments/<%= experiment.id %>/export/merged.csv">Download merged A+B CSV</a>
          </div>
          <div class="table-wrap">
            <table id="table-b">
              <thead>
                <tr>
                  <th>Mold order</th>
                  <th>SampleCode</th>
                  <th>BatchCode</th>
                  <th>Recipe</th>
                  <th>Mold temp (C)</th>
                  <th>Rep</th>
                  <% sampleFields.forEach((field) => { %>
                    <th>
                      <div class="field-header">
                        <span><%= field.label %></span>
                        <div class="field-icons">
                          <% if (field.type === 'number') { %>
                            <label class="icon-toggle" title="Include in analysis">
                              <input type="checkbox" data-field-toggle data-field-key="<%= field.key %>" <%= field.is_core ? 'data-field-core=\"1\"' : '' %> <%= analysisMetricKeys.includes(field.key) ? 'checked' : '' %> />
                              <span class="material-symbols-outlined">analytics</span>
                            </label>
                          <% } %>
                          <button type="button" class="icon-btn" title="Edit" data-edit-field data-field-key="<%= field.key %>" data-field-label="<%= field.label %>" data-field-type="<%= field.type %>" data-field-options="<%= (field.options || []).join(', ') %>" data-field-core="<%= field.is_core ? '1' : '0' %>" data-field-default="<%= field.is_default ? '1' : '0' %>">
                            <span class="material-symbols-outlined">edit</span>
                          </button>
                          <% if (!field.is_default) { %>
                            <form method="POST" action="/experiments/<%= experiment.id %>/fields/<%= field.key %>/delete" class="field-delete-form" onsubmit="return confirm('Delete this field and its data?')">
                              <button type="submit" class="icon-btn" title="Delete">
                                <span class="material-symbols-outlined">delete</span>
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </div>
                    </th>
                  <% }) %>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% samples.forEach((s) => { %>
                  <% const extra = s.extra_json ? JSON.parse(s.extra_json) : {}; %>
                  <tr class="<%= s.done ? 'row-done' : '' %>">
                    <td><%= s.mold_order %></td>
                    <td>
                      <a href="/experiments/<%= experiment.id %>/samples/<%= s.id %>"><%= s.sample_code %></a>
                      <% if (s.done) { %>
                        <span class="badge ok">DONE</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/experiments/<%= experiment.id %>/batches/<%= s.batch_id %>"><%= s.batch_code %></a>
                    </td>
                    <td><%= s.recipe_name %></td>
                    <td><%= s.mold_temp_c %></td>
                    <td><%= s.replicate %></td>
                    <% sampleFields.forEach((field) => { %>
                      <td>
                        <% if (field.type === 'number') { %>
                          <% if (field.is_core && Object.prototype.hasOwnProperty.call(s, field.key)) { %>
                            <input data-inline-save data-url="/experiments/<%= experiment.id %>/samples/<%= s.id %>" name="<%= field.key %>" value="<%= s[field.key] ?? '' %>" />
                          <% } else { %>
                            <input data-inline-save data-url="/experiments/<%= experiment.id %>/samples/<%= s.id %>" name="extra__<%= field.key %>" value="<%= extra[field.key] ?? '' %>" />
                          <% } %>
                        <% } else if (field.type === 'tags') { %>
                          <select multiple data-inline-save data-url="/experiments/<%= experiment.id %>/samples/<%= s.id %>" name="extra__<%= field.key %>">
                            <% (field.options || []).forEach((opt) => { %>
                              <option value="<%= opt %>" <%= Array.isArray(extra[field.key]) && extra[field.key].includes(opt) ? 'selected' : '' %>><%= opt %></option>
                            <% }) %>
                          </select>
                        <% } else { %>
                          <input data-inline-save data-url="/experiments/<%= experiment.id %>/samples/<%= s.id %>" name="extra__<%= field.key %>" value="<%= extra[field.key] ?? '' %>" />
                        <% } %>
                      </td>
                    <% }) %>
                    <td><textarea data-inline-save data-url="/experiments/<%= experiment.id %>/samples/<%= s.id %>" name="notes_mold"><%= s.notes_mold ?? '' %></textarea></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="tab-analysis" class="tab-panel">
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <h2>Decision Support</h2>
            <div style="display:flex; gap:12px; align-items:center;">
              <label class="small" style="margin:0;">
                <input type="checkbox" data-crosslink-toggle />
                Use Crosslink Index
              </label>
              <div class="inline-grid" style="grid-template-columns:auto auto; gap:8px;">
                <label style="margin:0;">Crosslink α</label>
                <input type="number" step="0.1" value="1.5" data-alpha-input style="width:100px;" />
              </div>
            </div>
          </div>
          <div id="analysis-quality" data-analysis-endpoint="/experiments/<%= experiment.id %>/analysis.json"></div>
          <div id="analysis-insights" style="margin-top:12px;"></div>
        </div>

        <div class="card">
          <h2>Visuals</h2>
          <div id="analysis-visuals" class="chart-grid"></div>
        </div>

        <div class="card">
          <h2>Data Quality</h2>
          <p class="<%= analysis.dataQualityOk ? 'good' : 'bad' %>">
            <%= analysis.dataQualityOk ? 'Data looks complete. You can proceed with analysis.' : 'Data is incomplete. Please finish data entry before interpreting results.' %>
          </p>
          <p>
            Missing in Table A:
            head set <span class="<%= analysis.missingBatch.head_set > 0 ? 'bad' : 'good' %>"><%= analysis.missingBatch.head_set %></span>,
            head actual <span class="<%= analysis.missingBatch.head_actual > 0 ? 'bad' : 'good' %>"><%= analysis.missingBatch.head_actual %></span>,
            moist after dry <span class="<%= analysis.missingBatch.moist_after_dry > 0 ? 'bad' : 'good' %>"><%= analysis.missingBatch.moist_after_dry %></span>,
            moist before mold <span class="<%= analysis.missingBatch.moist_before_mold > 0 ? 'bad' : 'good' %>"><%= analysis.missingBatch.moist_before_mold %></span>
          </p>
          <p>
            Missing in Table B:
            solubles <span class="<%= analysis.missingSample.solubles_pct > 0 ? 'bad' : 'good' %>"><%= analysis.missingSample.solubles_pct %></span>,
            swelling <span class="<%= analysis.missingSample.swelling_g_g > 0 ? 'bad' : 'good' %>"><%= analysis.missingSample.swelling_g_g %></span>,
            density <span class="<%= analysis.missingSample.density_g_cm3 > 0 ? 'bad' : 'good' %>"><%= analysis.missingSample.density_g_cm3 %></span>
          </p>
          <p>
            Moist before mold range:
            <span class="<%= analysis.batchMoistMin === null ? 'bad' : 'good' %>"><%= analysis.batchMoistMin ?? 'n/a' %></span>
            to
            <span class="<%= analysis.batchMoistMax === null ? 'bad' : 'good' %>"><%= analysis.batchMoistMax ?? 'n/a' %></span>
          </p>
        </div>

        <div id="analysis-metric-tables"></div>
      </section>
    </main>
  </body>
</html>

