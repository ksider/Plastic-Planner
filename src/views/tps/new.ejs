<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>New TPS Experiment</title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script defer src="/public/app.js"></script>
  </head>
  <body>
    <header>
      <div class="header-line">
        <a class="back-link" href="#" data-back-link>←</a>
        <h1>New TPS Experiment</h1>
      </div>
      <%- include('../shared/partials/nav', { active: 'tps' }) %>
    </header>
    <main>
      <div class="card">
        <form method="POST" action="/tps">
          <div class="inline-grid">
            <div>
              <label>Experiment name</label>
              <input name="name" required />
            </div>
            <div>
              <label>Seed (optional)</label>
              <input name="seed" type="number" inputmode="numeric" />
            </div>
            <div style="grid-column:1/-1;">
              <label>Notes</label>
              <textarea name="notes" rows="2"></textarea>
            </div>
          </div>

          <%- include('../shared/partials/recipe_select', { recipes, title: 'Select Recipes' }) %>

          <div style="margin-top:12px;">
            <button type="submit">Create TPS Experiment</button>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>

