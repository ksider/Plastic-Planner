<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= run.run_code %></title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script defer src="/public/im.js"></script>
    <script defer src="/public/app.js"></script>
  </head>
  <body>
    <header>
      <div class="header-line">
        <a class="back-link" href="#" data-back-link>←</a>
        <h1><%= run.run_code %></h1>
      </div>
      <div class="small"><%= experiment.name %> · <%= run.recipe_name || 'No recipe' %></div>
      <%- include('../shared/partials/nav', { active: 'im' }) %>
      <div style="margin-top:8px;">
        <a class="btn secondary" href="/im/<%= experiment.id %>">Back to experiment</a>
      </div>
    </header>
    <main class="run-page">
      <div class="card">
        <h2>Experiment settings</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              <% if (settingsList.length === 0) { %>
                <tr><td colspan="2">No active settings.</td></tr>
              <% } %>
              <% settingsList.forEach((item) => { %>
                <tr>
                  <td><%= item.label %></td>
                  <td><%= item.value %> <%= item.unit ? item.unit : '' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card run-hero">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
          <h2 style="margin:0;">Run status</h2>
          <% if (run.done) { %>
            <span class="badge ok">DONE</span>
          <% } %>
        </div>
        <form method="POST" action="/im/<%= experiment.id %>/runs/<%= run.id %>" class="run-form" data-im-run-form data-im-run-url="/im/<%= experiment.id %>/runs/<%= run.id %>">
          <div class="small">
            Recipe: <strong><%= run.recipe_name || '—' %></strong>
            <% if (run.recipe_variant) { %>
              <span class="badge tiny"><%= run.recipe_variant %></span>
            <% } %>
          </div>
          <div class="done-toggle">
            <span>Done</span>
            <label class="switch">
              <input type="hidden" name="done" value="0" />
              <input type="checkbox" name="done" value="1" <%= run.done ? 'checked' : '' %> />
              <span class="slider"></span>
            </label>
          </div>
          <div class="done-toggle">
            <span>Exclude from analysis</span>
            <label class="switch">
              <input type="hidden" name="exclude_from_analysis" value="0" />
              <input type="checkbox" name="exclude_from_analysis" value="1" <%= run.exclude_from_analysis ? 'checked' : '' %> />
              <span class="slider"></span>
            </label>
          </div>
        </form>
      </div>

      <div class="card">
        <div class="card-header">
          <h2>Measured outputs</h2>
          <form method="POST" action="/im/<%= experiment.id %>/analysis-fields" class="analysis-field-form">
            <input type="hidden" name="redirect_to" value="/im/<%= experiment.id %>/runs/<%= run.id %>" />
            <input name="label" placeholder="Field label" required />
            <select name="field_type">
              <option value="number">Number</option>
              <option value="text">Text</option>
              <option value="tag">Tag</option>
            </select>
            <input name="unit" placeholder="Unit" />
            <input name="display_group" placeholder="Group" />
            <input name="allowed_values" placeholder="Tags (comma-separated)" />
            <label class="check-inline">
              <input type="checkbox" name="is_global" value="1" />
              <span>Global</span>
            </label>
            <button type="submit">Add field</button>
          </form>
        </div>
        <form method="POST" action="/im/<%= experiment.id %>/runs/<%= run.id %>" class="run-form" data-im-run-form data-im-run-url="/im/<%= experiment.id %>/runs/<%= run.id %>">
          <% analysisGroups.forEach((group) => { %>
            <fieldset class="param-fieldset">
              <legend>Outputs · <%= group.group %></legend>
              <div class="run-compact-grid">
                <% group.fields.forEach((field) => { %>
                  <% const valueRow = analysisValueMap.get(field.id); %>
                  <% const fieldType = field.field_type || 'number'; %>
                  <% const fieldClass = fieldType === 'tag' || fieldType === 'text' ? 'run-wide' : ''; %>
                  <label class="run-compact-field <%= fieldClass %>">
                    <span><%= field.label %> <%= field.unit ? `(${field.unit})` : '' %></span>
                    <% if (fieldType === 'tag') { %>
                      <% let selectedTags = []; %>
                      <% if (valueRow && valueRow.value_tags_json) { %>
                        <% try { const parsed = JSON.parse(valueRow.value_tags_json); if (Array.isArray(parsed)) selectedTags = parsed.map(String); } catch {} %>
                      <% } %>
                      <% const tagOptions = field.allowedValues || []; %>
                      <input type="hidden" name="analysis_<%= field.id %>" value="" />
                      <% if (tagOptions.length > 0) { %>
                        <div class="tag-cloud">
                          <% tagOptions.forEach((opt) => { %>
                            <label class="tag-pill">
                              <input type="checkbox" name="analysis_<%= field.id %>" value="<%= opt %>" <%= selectedTags.includes(opt) ? 'checked' : '' %> />
                              <span><%= opt %></span>
                            </label>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <input class="run-input" type="text" name="analysis_<%= field.id %>" value="<%= selectedTags.join(', ') %>" placeholder="Tag list" />
                      <% } %>
                    <% } else if (fieldType === 'text') { %>
                      <textarea name="analysis_<%= field.id %>" rows="3"><%= valueRow?.value_text ?? '' %></textarea>
                    <% } else { %>
                      <input class="run-input" type="text" inputmode="decimal" name="analysis_<%= field.id %>" value="<%= valueRow?.value_real ?? '' %>" />
                    <% } %>
                  </label>
                <% }) %>
              </div>
            </fieldset>
          <% }) %>
        </form>
      </div>

      <div class="card run-nav">
        <% if (prevId) { %>
          <a class="btn secondary" href="/im/<%= experiment.id %>/runs/<%= prevId %>">Prev run</a>
        <% } else { %>
          <span class="muted">Prev run</span>
        <% } %>
        <% if (nextId) { %>
          <a class="btn secondary" href="/im/<%= experiment.id %>/runs/<%= nextId %>">Next run</a>
        <% } else { %>
          <span class="muted">Next run</span>
        <% } %>
      </div>
    </main>
  </body>
</html>
