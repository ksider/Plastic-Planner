<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>New IM Experiment</title>
    <link rel="stylesheet" href="/public/styles.css" />
    <script defer src="/public/im.js"></script>
    <script defer src="/public/app.js"></script>
  </head>
  <body>
    <header>
      <div class="header-line">
        <a class="back-link" href="#" data-back-link>←</a>
        <h1>New IM Experiment</h1>
      </div>
      <%- include('../shared/partials/nav', { active: 'im' }) %>
    </header>
    <main>
      <div class="card">
        <form method="POST" action="/im">
          <div class="inline-grid">
            <div>
              <label>Experiment name</label>
              <input name="name" required />
            </div>
            <div>
              <label>Machine profile</label>
              <select name="machine_profile_id">
                <% profiles.forEach((p) => { %>
                  <option value="<%= p.id %>"><%= p.name %> (zones: <%= p.barrel_zones_count %>)</option>
                <% }) %>
              </select>
            </div>
            <div>
              <label>Seed (optional)</label>
              <input name="seed" type="number" inputmode="numeric" />
            </div>
            <div>
              <label>Default material moisture (%)</label>
              <input name="default_material_moisture_pct" type="number" step="0.01" inputmode="decimal" />
            </div>
            <div>
              <label>Default material density (g/cm3)</label>
              <input name="default_material_density_g_cm3" type="number" step="0.001" inputmode="decimal" />
            </div>
            <div>
              <label>Design</label>
              <select name="design_mode">
                <option value="FULL">Full factorial</option>
                <option value="BBD">Box–Behnken</option>
              </select>
            </div>
          </div>

          <%- include('../shared/partials/recipe_select', { recipes, title: 'Recipes for this experiment' }) %>

          <div style="margin-top:12px;">
            <button type="submit">Create IM Experiment</button>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
